<Application x:Class="RechercheLivres.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RechercheLivres"
    xmlns:viewmodels="clr-namespace:RechercheLivres.ViewModels"
    xmlns:views="clr-namespace:RechercheLivres.View"
             StartupUri="View/Home.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--#region Assignation des dataTempaltes Views à VM (Linker le ContentControl de SelectedVM à xaml correspondant au VM)
                *Si t'oublies de faire ça, le nom de la VM sera affichée en texte dans ta page et ne loadera pas.-->

            <DataTemplate DataType="{x:Type viewmodels:SearchListVM}">
                <views:SearchListUC />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:MainVM}">
                <views:Home/>
            </DataTemplate>

            <!--#endregion-->

        </ResourceDictionary>
    </Application.Resources>
</Application>