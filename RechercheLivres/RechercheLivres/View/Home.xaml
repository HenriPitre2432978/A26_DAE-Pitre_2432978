<Window
    x:Class="RechercheLivres.View.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RechercheLivres"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:RechercheLivres.ViewModels"
    Title="Home"
    Width="1100"
    Height="500"
    MinWidth="1000"
    MinHeight="650"
    d:DataContext="{d:DesignInstance Type=vm:MainVM}"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <!--  Welcome Panel  -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F0EFFF" />
                    <GradientStop Offset="0.5" Color="#FAF0FF" />
                    <GradientStop Offset="1" Color="#EFF6FF" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="32">
                <Border
                    Width="420"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="16"
                    Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                            Margin="0,6,0,20"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            FontSize="14"
                            Foreground="#9898B8">
                            Recherchez vos livres rapidement
                        </TextBlock>

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Light"
                            FontSize="30"
                            Foreground="#2D2D3A"
                            Text="Recherche de Livres" />
                        <TextBlock
                            Margin="0,6,0,20"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            FontSize="14"
                            Foreground="#9898B8"> 
                            Henri Pitre - 2432978
                        </TextBlock>
                        <Button
                            Margin="0,10,0,0"
                            Command="{Binding GoToSearchListCommand}"
                            Content="Rechercher"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ContentControl for all other views  -->
        <ContentControl Content="{Binding CurrentView}" />
    </Grid>
</Window>